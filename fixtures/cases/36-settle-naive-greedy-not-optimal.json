    "settle",
    "optimality"
  ],
  "trip": {
    "home_currency": "USD",
    "members": [
      "alice",
      "bob",
      "carol",
      "dave",
      "erin"
    ]
  },
  "expenses": [
    {
      "id": "e1",
      "amount": 7000,
      "paid_by": {
        "carol": 4000,
        "dave": 3000
      },
      "split": {
        "type": "exact",
        "amounts": {
          "alice": 3000,
          "bob": 2000,
          "erin": 2000
        }
      }
    }
  ],
  "expected": {
    "balances": {
      "alice": -3000,
      "bob": -2000,
      "carol": 4000,
      "dave": 3000,
      "erin": -2000
    },
    "settle": {
      "min_payments": 3,
      "plan": [
        {
          "from": "alice",
          "to": "dave",
          "amount": 3000
        },
        {
          "from": "bob",
          "to": "carol",
          "amount": 2000
        },
        {
          "from": "erin",
          "to": "carol",
          "amount": 2000
        }
      ]
    }
  }
}
